# ============================================================
# Конфигурация деплоя (production).
# Скопируй в .env и поправь под свой сервер:
#   cp .env.example .env && nano .env
# ============================================================

# ---------- Хранилище ----------
# Корневая директория на хосте, где лежат БД, файлы книг, бэкапы.
# Все поддиректории создаст install.sh.
STORAGE_ROOT=/var/library

# ---------- PostgreSQL ----------
POSTGRES_USER=library
POSTGRES_DB=library
# ОБЯЗАТЕЛЬНО смени на длинный случайный пароль перед запуском!
# Сгенерировать: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---------- API ----------
# Подпись JWT-токенов. Минимум 32 символа.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30

# CORS: чтобы фронт мог стучаться в API напрямую.
# Для одного домена через nginx можно оставить * — фронт всё равно ходит через тот же origin.
ALLOWED_ORIGINS=*

# ---------- Frontend ----------
# Префикс к API из браузера. Если nginx проксирует /api → api:2020 — оставь /api.
NUXT_PUBLIC_API_BASE=/api

# ---------- nginx ----------
HTTP_PORT=80
HTTPS_PORT=443

# ---------- Образы ----------
# Если используешь приватный registry — пропиши здесь.
# Для офлайн-инстанса (docker load) оставь localhost.
REGISTRY=localhost
# TAG — версия образов. install.sh выставляет его автоматически из файла VERSION
# в bundle при каждой установке/обновлении, поэтому вручную менять не нужно.
TAG=latest

# ---------- Бэкапы ----------
# Расписание ночного pg_dump (cron-формат).
# По умолчанию каждый день в 03:00.
# ВАЖНО: в двойных кавычках — install.sh подхватывает .env через shell-source,
# и `0 3 * * *` без кавычек bash трактует как команды.
BACKUP_CRON="0 3 * * *"
# Сколько хранить ежедневных и еженедельных копий
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
