# PostgreSQL
POSTGRES_USER=library
POSTGRES_PASSWORD=library
POSTGRES_DB=library
POSTGRES_PORT=5432

# API
API_PORT=2020
DATABASE_URL=postgres://library:library@postgres:5432/library?sslmode=disable
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30
STORAGE_PATH=/var/library
ALLOWED_ORIGINS=http://localhost:2026

# Frontend
FRONTEND_PORT=2026
NUXT_PUBLIC_API_BASE=http://localhost:2020/api

# Docker registry (для prod-деплоя)
REGISTRY=localhost
TAG=latest
